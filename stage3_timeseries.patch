+# ====================================================================
+# 데이터 준비
+# ====================================================================
+def read_survey_file(uploaded_file) -> pd.DataFrame:
+    """CSV(utf-8-sig / cp949 자동 판별) 또는 Excel 읽기."""
+    name = uploaded_file.name.lower()
+    if name.endswith((".xlsx", ".xls")):
+        return pd.read_excel(uploaded_file)
+    raw = uploaded_file.getvalue()
+    for enc in ("utf-8-sig", "cp949", "euc-kr"):
+        try:
+            return pd.read_csv(io.BytesIO(raw), encoding=enc)
+        except UnicodeDecodeError:
+            continue
+    return pd.read_csv(io.BytesIO(raw), encoding="utf-8", encoding_errors="replace")
+
+
+def detect_scale_columns(df: pd.DataFrame, scale_min: float, scale_max: float, min_ratio: float = 0.8) -> list[str]:
+    """값의 대부분(min_ratio)이 척도 범위 안의 숫자인 열 = 척도형 문항 후보."""
+    cols = []
+    for c in df.columns:
+        s = pd.to_numeric(df[c], errors="coerce").dropna()
+        if len(s) < 3:
+            continue
+        in_range = s.between(scale_min, scale_max).mean()
+        if in_range >= min_ratio and s.nunique() <= (scale_max - scale_min + 1) + 1:
+            cols.append(c)
+    return cols
+
+
+def guess_overall_column(cols: list[str]) -> str | None:
+    for kw in OVERALL_KEYWORDS:
+        for c in cols:
+            if kw.lower() in str(c).lower():
+                return c
+    return cols[-1] if cols else None
+
+
+def suggest_dimension_mapping(item_cols: list[str]) -> dict[str, list[str]]:
+    """키워드 일치 개수가 가장 많은 차원으로 문항 배정. 일치 없으면 미배정."""
+    mapping = {d: [] for d in DIMENSIONS}
+    for col in item_cols:
+        name = str(col)
+        scores = {d: sum(kw.lower() in name.lower() for kw in kws) for d, kws in DIMENSION_KEYWORDS.items()}
+        best = max(scores, key=scores.get)
+        if scores[best] > 0:
+            mapping[best].append(col)
+    return mapping
+
+
+def clean_scale(series: pd.Series, scale_min: float, scale_max: float) -> tuple[pd.Series, int]:
+    """숫자 변환 + 척도 범위 밖 값(예: 0=해당없음, 9=무응답)은 결측 처리. (정제값, 결측 처리 수) 반환."""
+    s = pd.to_numeric(series, errors="coerce")
+    out_of_range = s.notna() & ~s.between(scale_min, scale_max)
+    return s.mask(out_of_range), int(out_of_range.sum())
+
+
+def to_pomp(series: pd.Series, scale_min: float, scale_max: float) -> pd.Series:
+    """POMP(Percent Of Maximum Possible) 100점 환산: 척도가 다른 연도 간 비교용."""
+    return (series - scale_min) / (scale_max - scale_min) * 100
+
+
+# ====================================================================
+# 통계 함수
+# ====================================================================
+def cohens_d(a: np.ndarray, b: np.ndarray) -> float:
+    na, nb = len(a), len(b)
+    sp = math.sqrt(((na - 1) * np.var(a, ddof=1) + (nb - 1) * np.var(b, ddof=1)) / (na + nb - 2))
+    return float((np.mean(b) - np.mean(a)) / sp) if sp > 0 else float("nan")
+
+
+def interpret_d(d: float) -> str:
+    ad = abs(d)
+    if np.isnan(ad):
+        return "-"
+    return "무시할 수준" if ad < 0.2 else "작음" if ad < 0.5 else "중간" if ad < 0.8 else "큼"
+
+
+def compare_two_groups(a, b, method: str = "auto") -> dict:
+    """독립표본 비교. method: 'auto'(Levene p<.05 → Welch), 'welch', 'student'."""
+    a = pd.Series(a).dropna().to_numpy(dtype=float)
+    b = pd.Series(b).dropna().to_numpy(dtype=float)
+    res = {"n_a": len(a), "n_b": len(b)}
+    if len(a) < 2 or len(b) < 2:
+        res["error"] = "표본이 2개 미만이라 검정할 수 없습니다."
+        return res
+    lev = stats.levene(a, b, center="median")
+    student = stats.ttest_ind(b, a, equal_var=True)
+    welch = stats.ttest_ind(b, a, equal_var=False)
+    # Welch-Satterthwaite 자유도
+    va, vb = np.var(a, ddof=1) / len(a), np.var(b, ddof=1) / len(b)
+    welch_df = (va + vb) ** 2 / (va ** 2 / (len(a) - 1) + vb ** 2 / (len(b) - 1)) if (va + vb) > 0 else np.nan
+
+    if method == "auto":
+        use_welch = lev.pvalue < 0.05
+    else:
+        use_welch = method == "welch"
+    chosen = welch if use_welch else student
+    df_used = welch_df if use_welch else len(a) + len(b) - 2
+
+    diff = b.mean() - a.mean()
+    se = math.sqrt(va + vb) if use_welch else math.sqrt(
+        (((len(a) - 1) * np.var(a, ddof=1) + (len(b) - 1) * np.var(b, ddof=1)) / (len(a) + len(b) - 2))
+        * (1 / len(a) + 1 / len(b)))
+    tcrit = stats.t.ppf(0.975, df_used) if np.isfinite(df_used) else np.nan
+    mw = stats.mannwhitneyu(b, a, alternative="two-sided")
+
+    res.update({
+        "mean_a": a.mean(), "sd_a": a.std(ddof=1),
+        "mean_b": b.mean(), "sd_b": b.std(ddof=1),
+        "diff": diff, "ci_low": diff - tcrit * se, "ci_high": diff + tcrit * se,
+        "levene_F": lev.statistic, "levene_p": lev.pvalue,
+        "test_name": "Welch t-검정 (등분산 가정 X)" if use_welch else "Student t-검정 (등분산 가정)",
+        "t": chosen.statistic, "df": df_used, "p": chosen.pvalue,
+        "t_student": student.statistic, "p_student": student.pvalue,
+        "t_welch": welch.statistic, "p_welch": welch.pvalue,
+        "d": cohens_d(a, b),
+        "mw_U": mw.statistic, "mw_p": mw.pvalue,
+    })
+    res["d_label"] = interpret_d(res["d"])
+    return res
+
+
+def holm_adjust(pvals: list[float]) -> list[float]:
+    p = np.asarray(pvals, dtype=float)
+    m = np.sum(~np.isnan(p))
+    order = np.argsort(np.where(np.isnan(p), np.inf, p))
+    adj = np.full_like(p, np.nan)
+    running = 0.0
+    for rank, idx in enumerate(order):
+        if np.isnan(p[idx]):
+            continue
+        running = max(running, min(1.0, (m - rank) * p[idx]))
+        adj[idx] = running
+    return adj.tolist()
+
+
+def cronbach_alpha(items: pd.DataFrame) -> dict:
+    """Cronbach's α (listwise), Feldt 95% CI, 문항별 수정된 문항-총점 상관 및 문항 제거 시 α."""
+    data = items.apply(pd.to_numeric, errors="coerce").dropna()
+    k, n = data.shape[1], data.shape[0]
+    out = {"k": k, "n": n, "alpha": np.nan, "ci_low": np.nan, "ci_high": np.nan, "items": pd.DataFrame()}
+    if k < 2:
+        out["note"] = "문항이 1개여서 α 산출 불가 (최소 2문항 필요)"
+        return out
+    if n < 3:
+        out["note"] = "유효 응답이 부족합니다"
+        return out
+
+    def _alpha(d: pd.DataFrame) -> float:
+        kk = d.shape[1]
+        total_var = d.sum(axis=1).var(ddof=1)
+        if total_var == 0 or kk < 2:
+            return np.nan
+        return kk / (kk - 1) * (1 - d.var(ddof=1).sum() / total_var)
+
+    a = _alpha(data)
+    out["alpha"] = a
+    if np.isfinite(a) and a < 1:
+        df1, df2 = n - 1, (n - 1) * (k - 1)
+        out["ci_low"] = 1 - (1 - a) * stats.f.ppf(0.975, df1, df2)
+        out["ci_high"] = 1 - (1 - a) * stats.f.ppf(0.025, df1, df2)
+
+    rows = []
+    for c in data.columns:
+        rest = data.drop(columns=c)
+        citc = data[c].corr(rest.sum(axis=1)) if data[c].std() > 0 else np.nan
+        rows.append({"문항": c, "평균": data[c].mean(), "수정된 문항-총점 상관": citc,
+                     "문항 제거 시 α": _alpha(rest) if rest.shape[1] >= 2 else np.nan})
+    out["items"] = pd.DataFrame(rows)
+    return out
+
+
+def dimension_scores(df_items: pd.DataFrame, min_valid_ratio: float = 0.5) -> pd.Series:
+    """차원 점수 = 응답 문항 평균. 문항의 min_valid_ratio 이상 응답한 경우에만 산출."""
+    k = df_items.shape[1]
+    need = max(1, math.ceil(k * min_valid_ratio))
+    valid = df_items.notna().sum(axis=1)
+    return df_items.mean(axis=1).where(valid >= need)
+
+
+def shapley_r2(y: pd.Series, X: pd.DataFrame) -> pd.Series:
+    """일반 우세성 분석(Shapley R² 분해): 다중공선성 하에서도 안정적인 상대중요도."""
+    cols = list(X.columns)
+    p = len(cols)
+
+    def r2(subset):
+        if not subset:
+            return 0.0
+        return sm.OLS(y, sm.add_constant(X[list(subset)])).fit().rsquared
+
+    cache = {}
+    for r in range(p + 1):
+        for s in combinations(cols, r):
+            cache[frozenset(s)] = r2(s)
+    contrib = {}
+    for c in cols:
+        others = [o for o in cols if o != c]
+        total = 0.0
+        for r in range(p):
+            for s in combinations(others, r):
+                w = math.factorial(r) * math.factorial(p - r - 1) / math.factorial(p)
+                total += w * (cache[frozenset(s) | {c}] - cache[frozenset(s)])
+        contrib[c] = total
+    return pd.Series(contrib)
+
+
+def run_regression(df: pd.DataFrame, y_col: str, x_cols: list[str], robust: bool = True) -> dict:
+    data = df[[y_col] + x_cols].dropna()
+    n, p = len(data), len(x_cols)
+    out = {"n": n, "p": p}
+    if n < p + 3:
+        out["error"] = f"유효 표본(n={n})이 독립변수 수({p})에 비해 너무 적습니다."
+        return out
+    y, X = data[y_col], data[x_cols]
+    model = sm.OLS(y, sm.add_constant(X)).fit(cov_type="HC3" if robust else "nonrobust")
+    sd_y = y.std(ddof=1)
+    beta = {c: model.params[c] * X[c].std(ddof=1) / sd_y if sd_y > 0 else np.nan for c in x_cols}
+
+    vif = {}
+    for c in x_cols:
+        others = [o for o in x_cols if o != c]
+        if not others:
+            vif[c] = 1.0
+            continue
+        r2 = sm.OLS(X[c], sm.add_constant(X[others])).fit().rsquared
+        vif[c] = 1 / (1 - r2) if r2 < 1 else np.inf
+
+    shap = shapley_r2(y, X)
+    table = pd.DataFrame({
+        "B(비표준화)": [model.params[c] for c in x_cols],
+        "SE": [model.bse[c] for c in x_cols],
+        "β(표준화)": [beta[c] for c in x_cols],
+        "t": [model.tvalues[c] for c in x_cols],
+        "p": [model.pvalues[c] for c in x_cols],
+        "VIF": [vif[c] for c in x_cols],
+        "Shapley R²": [shap[c] for c in x_cols],
+    }, index=x_cols)
+    table["상대중요도(%)"] = table["Shapley R²"] / model.rsquared * 100 if model.rsquared > 0 else np.nan
+
+    out.update({
+        "model": model, "table": table,
+        "r2": model.rsquared, "adj_r2": model.rsquared_adj,
+        "F": float(model.fvalue), "F_p": float(model.f_pvalue),
+        "intercept": model.params["const"],
+        "top_beta": table["β(표준화)"].idxmax(),
+        "top_shapley": table["Shapley R²"].idxmax(),
+    })
+    return out
+
+
+def run_interaction_test(df_a: pd.DataFrame, df_b: pd.DataFrame, y_col: str, x_cols: list[str],
+                         robust: bool = True) -> dict:
+    """통합모형 y = X + Year + X×Year. 상호작용 계수 = 연도 간 영향력(기울기) 차이."""
+    a = df_a[[y_col] + x_cols].dropna().assign(Year=0)
+    b = df_b[[y_col] + x_cols].dropna().assign(Year=1)
+    pooled = pd.concat([a, b], ignore_index=True)
+    for c in x_cols:
+        pooled[f"{c}×연도"] = pooled[c] * pooled["Year"]
+    inter = [f"{c}×연도" for c in x_cols]
+    X = sm.add_constant(pooled[x_cols + ["Year"] + inter])
+    if len(pooled) < X.shape[1] + 3:
+        return {"error": "통합모형을 추정하기에 표본이 부족합니다."}
+    model = sm.OLS(pooled[y_col], X).fit(cov_type="HC3" if robust else "nonrobust")
+    R = np.zeros((len(inter), X.shape[1]))
+    for i, name in enumerate(inter):
+        R[i, list(X.columns).index(name)] = 1
+    joint = model.f_test(R)
+    table = pd.DataFrame({
+        "기울기 차이(B_비교 − B_기준)": [model.params[i] for i in inter],
+        "SE": [model.bse[i] for i in inter],
+        "t": [model.tvalues[i] for i in inter],
+        "p": [model.pvalues[i] for i in inter],
+    }, index=x_cols)
+    return {"table": table, "joint_F": float(np.squeeze(joint.fvalue)), "joint_p": float(joint.pvalue),
+            "df_num": int(joint.df_num), "df_denom": float(joint.df_denom), "n": len(pooled)}
+
+
+def sig_mark(p: float) -> str:
+    if p is None or np.isnan(p):
+        return ""
+    return "***" if p < .001 else "**" if p < .01 else "*" if p < .05 else "n.s."
+
+
+def p_text(p: float) -> str:
+    """문장용: 'p < .001' 또는 'p = 0.023'."""
+    f = fmt_p(p)
+    return f"p {f}" if f.startswith("<") else f"p = {f}"
+
+
+def josa_ro(word: str) -> str:
+    """받침 유무에 따른 '로/으로' (ㄹ 받침은 '로')."""
+    for ch in reversed(str(word)):
+        if "가" <= ch <= "힣":
+            jong = (ord(ch) - 0xAC00) % 28
+            return "로" if jong in (0, 8) else "으로"
+    return "(으)로"
+
+
+def fmt_p(p: float) -> str:
+    if p is None or np.isnan(p):
+        return "-"
+    return "< .001" if p < .001 else f"{p:.3f}"
+
