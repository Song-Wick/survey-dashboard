+def _prepare_year(df: pd.DataFrame, cols: list[str], smin: float, smax: float, pomp: bool):
+    """선택 열들을 정제(범위 밖 → 결측) 및 단위 변환. (정제 df, 범위 밖 결측 처리 수)"""
+    out, dropped = pd.DataFrame(index=df.index), 0
+    for c in cols:
+        s, n_out = clean_scale(df[c], smin, smax)
+        dropped += n_out
+        out[c] = to_pomp(s, smin, smax) if pomp else s
+    return out, dropped
