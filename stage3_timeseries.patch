+            results["mapping_summary"].to_excel(w, sheet_name="0_차원매핑")
+        r = results.get("step1", {})
+        if r and "error" not in r:
+            pd.DataFrame([
+                ["N", r["n_a"], r["n_b"]], ["평균", r["mean_a"], r["mean_b"]], ["표준편차", r["sd_a"], r["sd_b"]],
+                ["평균 차이", r["diff"], None], ["95% CI 하한", r["ci_low"], None], ["95% CI 상한", r["ci_high"], None],
+                ["Levene F", r["levene_F"], None], ["Levene p", r["levene_p"], None],
+                ["검정", r["test_name"], None], ["t", r["t"], None], ["df", r["df"], None], ["p", r["p"], None],
+                ["Cohen's d", r["d"], r["d_label"]], ["Mann-Whitney U", r["mw_U"], None], ["Mann-Whitney p", r["mw_p"], None],
+            ], columns=["항목", lab_a, lab_b]).to_excel(w, sheet_name="1_전반적만족도", index=False)
+        if "reliability" in results:
+            results["reliability"].to_excel(w, sheet_name="2_신뢰도", index=False)
+            rows = []
+            for (lab, d), t in results.get("reliability_items", {}).items():
+                if not t.empty:
+                    rows.append(t.assign(연도=lab, 차원=d))
+            if rows:
+                pd.concat(rows)[["연도", "차원", "문항", "평균", "수정된 문항-총점 상관", "문항 제거 시 α"]] \
+                    .to_excel(w, sheet_name="2_문항진단", index=False)
+        if "dimension_comparison" in results:
+            results["dimension_comparison"].to_excel(w, sheet_name="2_차원비교", index=False)
+        for lab, (t, rg) in results.get("regression", {}).items():
