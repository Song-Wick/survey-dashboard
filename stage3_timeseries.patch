+def _mapping_widgets(key: str, label: str, item_cols: list[str]) -> dict[str, list[str]]:
+    import streamlit as st
+    suggested = suggest_dimension_mapping(item_cols)
+    st.markdown(f"**{label}** — 후보 문항 {len(item_cols)}개")
+    mapping = {}
+    for d in DIMENSIONS:
+        wkey = f"ts_map_{key}_{DIM_CODES[d]}"
+        if wkey not in st.session_state:
+            st.session_state[wkey] = suggested[d]
+        else:  # 다른 열 목록으로 바뀐 경우 유효한 항목만 유지
+            st.session_state[wkey] = [c for c in st.session_state[wkey] if c in item_cols]
+        mapping[d] = st.multiselect(d, item_cols, key=wkey)
+    used = [c for v in mapping.values() for c in v]
+    dup = sorted({c for c in used if used.count(c) > 1})
+    unassigned = [c for c in item_cols if c not in used]
+    if dup:
+        st.error(f"여러 차원에 중복 배정된 문항: {', '.join(map(str, dup))}")
+    if unassigned:
+        st.caption(f"⚪ 미배정 문항 ({len(unassigned)}개, 분석에서 제외): {', '.join(map(str, unassigned))}")
+    return mapping
