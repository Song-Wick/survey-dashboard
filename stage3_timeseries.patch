+"""
+Stage 3: 연도별 만족도 시계열 비교 분석 모듈
+------------------------------------------------
+문항 수/문구가 바뀐 두 연도의 만족도 조사를 통계적으로 비교한다.
+
+  [1단계] 전반적 만족도 1:1 비교  : 독립표본 t-검정 (Levene → Student/Welch), Cohen's d, Mann-Whitney U(보조)
+  [2단계] 상위 차원 통합 비교      : 문항 → 3대 차원 매핑, 연도별 Cronbach's α(+Feldt 95% CI),
+                                     α 검증 차원의 평균 점수 비교(Welch t, Holm 보정)
+  [3단계] 영향인자(Driver) 구조 변화 : 연도별 다중회귀(B, β, VIF, R²) + Shapley R² 상대중요도,
+                                     통합모형 연도×차원 상호작용(Chow형) 검정
+
+통계 함수(앞부분)는 Streamlit과 독립적이므로 단위 테스트가 가능하다.
+"""
+from __future__ import annotations
+
+import io
+import json
+import math
+from itertools import combinations
+
+import numpy as np
+import pandas as pd
+import plotly.graph_objects as go
+import statsmodels.api as sm
+from scipy import stats
+
+# ====================================================================
+# 상수
+# ====================================================================
+DIMENSIONS = ["① 자료/정보", "② 시설/공간", "③ 서비스/프로그램"]
+DIM_CODES = {"① 자료/정보": "D1", "② 시설/공간": "D2", "③ 서비스/프로그램": "D3"}
+
+# 문항명 자동 매핑 제안용 키워드 (사용자가 화면에서 수정 가능)
+DIMENSION_KEYWORDS = {
+    "① 자료/정보": ["자료", "정보", "장서", "도서", "소장", "검색", "DB", "데이터베이스", "전자",
+                  "학술", "논문", "저널", "콘텐츠", "신착", "구입", "희망도서"],
+    "② 시설/공간": ["시설", "공간", "좌석", "열람실", "환경", "청결", "냉난방", "소음", "조명",
+                  "화장실", "와이파이", "Wi-Fi", "PC", "컴퓨터", "장비", "기기", "쾌적", "편의",
+                  "주차", "접근성", "스터디룸", "세미나실"],
+    "③ 서비스/프로그램": ["서비스", "프로그램", "직원", "친절", "응대", "교육", "강좌", "안내", "대출",
+                     "반납", "상담", "홈페이지", "행사", "문화", "홍보", "참고", "이용시간", "운영"],
+}
+OVERALL_KEYWORDS = ["전반적", "종합", "전체 만족", "overall"]
+
+COLOR_A = "#94A3B8"   # 이전 연도
+COLOR_B = "#4F46E5"   # 비교 연도
